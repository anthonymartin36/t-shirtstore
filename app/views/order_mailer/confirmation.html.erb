<div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; color: #333;">
  <div style="background-color: #dc2626; padding: 20px 24px;">
    <h1 style="color: #ffffff; margin: 0; font-size: 20px;">T-Shirt Store</h1>
  </div>

  <div style="padding: 24px;">
    <h2 style="font-size: 18px; margin-bottom: 4px;">Order Confirmed!</h2>
    <p style="font-size: 14px; color: #555; margin-top: 0;">
      Hi <%= @customer.email %>, thank you for your purchase.
    </p>

    <table style="width: 100%; font-size: 13px; margin-bottom: 4px;">
      <tr>
        <td style="color: #555;">Order number</td>
        <td style="text-align: right; font-weight: bold;">#<%= @order.id %></td>
      </tr>
      <tr>
        <td style="color: #555;">Date</td>
        <td style="text-align: right;"><%= @order.created_at.strftime('%d %B %Y') %></td>
      </tr>
    </table>

    <hr style="border: none; border-top: 1px solid #e5e7eb; margin: 16px 0;" />

    <h3 style="font-size: 14px; margin-bottom: 10px;">Items Ordered</h3>
    <table style="width: 100%; font-size: 13px; border-collapse: collapse;">
      <thead>
        <tr style="background-color: #f9fafb;">
          <th style="text-align: left; padding: 6px 8px; font-weight: 600;">Product</th>
          <th style="text-align: center; padding: 6px 8px; font-weight: 600;">Qty</th>
          <th style="text-align: right; padding: 6px 8px; font-weight: 600;">Price</th>
        </tr>
      </thead>
      <tbody>
        <% @items.each do |item| %>
          <tr style="border-top: 1px solid #f3f4f6;">
            <td style="padding: 6px 8px;"><%= item.product.image.image_name %></td>
            <td style="text-align: center; padding: 6px 8px;"><%= item.quantity %></td>
            <td style="text-align: right; padding: 6px 8px;">$<%= sprintf('%.2f', item.price.to_f * item.quantity) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <hr style="border: none; border-top: 1px solid #e5e7eb; margin: 16px 0;" />

    <table style="width: 100%; font-size: 13px;">
      <tr>
        <td style="color: #555; padding: 3px 0;">Subtotal</td>
        <td style="text-align: right;">$<%= sprintf('%.2f', @order.cost_price.to_f) %></td>
      </tr>
      <tr>
        <td style="color: #555; padding: 3px 0;">Tax</td>
        <td style="text-align: right;">$<%= sprintf('%.2f', @order.tax.to_f) %></td>
      </tr>
      <tr>
        <td style="color: #555; padding: 3px 0;">Shipping</td>
        <td style="text-align: right;">$<%= sprintf('%.2f', @order.courier_cost.to_f) %></td>
      </tr>
      <tr style="font-weight: bold; font-size: 14px; border-top: 1px solid #e5e7eb;">
        <td style="padding-top: 8px;">Total</td>
        <td style="text-align: right; padding-top: 8px;">$<%= sprintf('%.2f', @order.total.to_f) %></td>
      </tr>
    </table>

    <hr style="border: none; border-top: 1px solid #e5e7eb; margin: 16px 0;" />

    <div style="display: flex; gap: 24px; font-size: 13px;">
      <div style="flex: 1;">
        <h3 style="font-size: 14px; margin-bottom: 6px;">Shipping To</h3>
        <p style="margin: 0; line-height: 1.6;">
          <%= @shipment.full_name %><br/>
          <%= @shipment.address %><br/>
          <%= @shipment.city %>, <%= @shipment.postal_code %><br/>
          <%= @shipment.country %>
        </p>
      </div>
      <div style="flex: 1;">
        <h3 style="font-size: 14px; margin-bottom: 6px;">Payment</h3>
        <p style="margin: 0; line-height: 1.6;">
          <%= @payment.card_name %><br/>
          <%= @masked_card %>
        </p>
      </div>
    </div>

    <hr style="border: none; border-top: 1px solid #e5e7eb; margin: 24px 0 16px;" />

    <p style="font-size: 12px; color: #9ca3af; text-align: center; margin: 0;">
      T-Shirt Store &mdash; If you have any questions, reply to this email.
    </p>
  </div>
</div>
